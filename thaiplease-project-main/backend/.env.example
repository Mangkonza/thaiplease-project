PORT=5000
NODE_ENV=development

# ข้อมูลเชื่อมต่อ PostgreSQL Container
DB_HOST=localhost
DB_PORT=5433
DB_USER=thaiplease_user
DB_PASSWORD=thaiplease_password123
DB_NAME=thaiplease_db

# กุญแจสำหรับเซ็น JWT Token
JWT_SECRET=thaiplease_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d

# AI (D-07): OpenAI-compatible endpoint; key ของแต่ละคน ห้าม commit
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_MS=45000
AI_API_KEY=

# ผู้ให้บริการสำรองเจ้าที่สอง (เช่น Groq) ใช้เมื่อโมเดลของเจ้าหลักล้มทั้งหมด; เว้น key ว่าง = ไม่ใช้
AI_SECONDARY_BASE_URL=https://api.groq.com/openai/v1/
AI_SECONDARY_MODEL=openai/gpt-oss-120b
AI_SECONDARY_API_KEY=
